        },
        {
            "step_id": "step-7",
            "testo": "Spennellare la pasta con burro fuso.",
            "icona": "spennellare"
        },
        {
            "step_id": "step-8",
            "testo": "Versare sulla pasta il pan grattato.",
            "icona": "aggiungere"
        },
        {
            "step_id": "step-9",
            "testo": "Distribuire le mele (scolate dall’acqua che si sarà formata), l’uvetta, i pinoli e spolverare con poca cannella.",
            "icona": "aggiungere"
        },
        {
            "step_id": "step-10",
            "testo": "Aiutandosi con un torcione pulito, far rotolare su se stessa la pasta creando un grosso rotolo.",
            "icona": "impastare_mano"
        },
        {
            "step_id": "step-11",
            "testo": "Spennellare con burro fuso e cuocere in forno a 180°C finchè la pasta non sarà dorata (circa 30-35 minuti).",
